mach create "SignerLab"

machine LoadPlatformDescription $ORIGIN/signer.repl
# Factory-blank data sectors (counter log, key store): the device generates a new key on first boot,
# so every new Renode session is a new device (enrol it again).
sysbus LoadBinary $ORIGIN/../firmware/build/blank-16k.bin 0x08008000
sysbus LoadBinary $ORIGIN/../firmware/build/blank-16k.bin 0x0800C000
sysbus LoadBinary $ORIGIN/../firmware/build/blank-64k.bin 0x08010000

# Reload the image on every machine reset (e.g. after a watchdog reset).
macro reset
"""
    sysbus LoadELF $ORIGIN/../firmware/build/signer.elf
"""
runMacro $reset

emulation CreateUartPtyTerminal "host_uart" "/tmp/signer-uart"
connector Connect sysbus.uart4 host_uart

start
